{
  "manifest_version": 3,
  "name": "Pathhelp @tuik",
  "version": "3.0.2",
  "description": "Assistant for CBC / PBS / MP result entry: abnormal findings, DC fix, one-tap MP/PBS text. Opens as a toolbar popup. Everything stays in the browser.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Pathhelp @tuik"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      },
      "description": "Open Pathhelp @tuik"
    }
  }
}